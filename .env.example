# Database
DATABASE_URL=sqlite:///./patrimonio.db
# DATABASE_URL=postgresql://user:password@localhost:5432/patrimonio

# API
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=True
ENVIRONMENT=dev

# yFinance
YFINANCE_TIMEOUT=10
PRICE_CACHE_TTL=3600

# Logging
LOG_LEVEL=INFO

# Initial data directory (contains personal financial data)
INIT_DATA_DIR=init_data

# CORS
CORS_ORIGINS=["*"]
